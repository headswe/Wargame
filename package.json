{
  "name": "wargame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tactical real-time squad combat. PMC fireteams, cover, suppression.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "playtest": "node tools/playtest.mjs",
    "balance": "node --experimental-strip-types tools/balance.ts",
    "editor-check": "node tools/editor-check.mjs",
    "level-report": "node --experimental-strip-types tools/level-report.ts",
    "textures": "node tools/textures.mjs",
    "ground-grain": "node tools/ground-grain.mjs"
  },
  "dependencies": {
    "@types/earcut": "^3.0.0",
    "earcut": "^3.2.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
